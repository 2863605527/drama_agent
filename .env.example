# ============================================================
# Drama-Agent 环境配置
# 复制本文件为 .env，填入你的密钥即可
# Docker 部署时 .env 由 docker-compose 自动注入，不打包进镜像
# ============================================================

# ====== 必需：火山引擎（图片/视频生成，cv 通道默认）======
VOLC_ACCESS_KEY=your_volc_access_key
VOLC_SECRET_KEY=your_volc_secret_key
VOLC_REGION=cn-beijing

# ====== LLM 大模型（剧本生成与解析）======
# 说明：前端「通道配置」已全部改为手动配置（含 LLM），下面的 .env 值仅作为
# 「用户未在前端配置任何通道」时的最后兜底，不是主配置入口。
LLM_API_URL=https://api.deepseek.com
LLM_API_KEY=your_deepseek_api_key
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.7

# ====== 必需：MySQL 数据库（Docker 容器内运行）======
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=drama_agent
MYSQL_USER=drama
MYSQL_PASSWORD=drama_2024
MYSQL_ROOT_PASSWORD=drama_root_2024
MYSQL_PORT_HOST=3306

# ====== 必需：JWT 鉴权（用户登录 token 签名密钥，上线必须修改）======
JWT_SECRET_KEY=please-change-this-to-a-random-secret-string
JWT_EXPIRE_MINUTES=1440

# ====== 应用端口 ======
APP_PORT=8010

# ====== 运行环境：development / production（production 会强制校验 JWT 密钥等）======
ENVIRONMENT=development
DEBUG=false

# ====== 跨域 CORS：逗号分隔的允许来源（默认已收敛为本地开发白名单；生产配置实际域名）======
# CORS_ORIGINS=http://127.0.0.1:8010,https://your-domain.com

# ====== 接口限流：登录/注册、全局 API（格式 次数/时间窗 minute|second|hour）======
LOGIN_RATE_LIMIT=5/minute
API_RATE_LIMIT=120/minute

# ====== MCP 子进程调用超时（秒）与 Python 解释器路径（容器内 python，本地可改 python.exe）======
MCP_CALL_TIMEOUT=180
# PYTHON_BIN=python

# ====== 生产 gunicorn worker 数（本地/SSE 建议 1，生产可设 2~4）======
WEB_CONCURRENCY=1

# ====== 多实例水平扩展（可选，单机留空）：Redis 分布式限流 + SSE 跨实例广播 ======
# REDIS_URL=redis://redis:6379/0


# ====== 图片/视频生成通道 ======
# 说明：前端「通道配置」已全部改为手动配置（选择 CV/ARK/通用HTTP 并填 Key）。
# 下面的 IMAGE_CHANNEL / VIDEO_CHANNEL 仅作为「用户未配置」时的最后兜底，不是主配置入口。
IMAGE_CHANNEL=volc_cv
IMAGE_REQ_KEY=jimeng_high_aes_general_v21_L
IMAGE_MAX_CONCURRENCY=3
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024

# ====== 视频生成通道 ======
VIDEO_CHANNEL=volc_cv
VIDEO_REQ_KEY=jimeng_t2v_v30
VIDEO_MAX_CONCURRENCY=2
# 单片段时长范围（秒）
VIDEO_DURATION_RANGE=3,15
# 档位制模型的帧数选项（即梦：121帧=5s, 241帧=10s）
VIDEO_DURATION_SLOTS=121:5,241:10
# 生成后是否裁剪到精确时长（档位制需要，任意时长制不需要）
VIDEO_TRIM=true

# ====== 片段分组约束 ======
SEGMENT_MAX_DURATION=15
SEGMENT_MAX_SHOTS=4

# ====== TTS 配音（edge-tts，免费，无需密钥）======
ENABLE_TTS=true
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_RATE=+0%

# ============================================================
# 以下为可选配置，使用对应通道时才需要填写
# ============================================================

# ====== 可选：方舟通道（VIDEO_CHANNEL=volc_ark 时使用）======
# ARK_API_KEY=your_ark_api_key
# ARK_API_URL=https://ark.cn-beijing.volces.com/api/v3
# ARK_VIDEO_MODEL=doubao-seedance-1-0-pro-250528
# ARK_IMAGE_MODEL=doubao-seedream-3-0-t2i-250428
# ARK_VIDEO_AUDIO=true
# ARK_VIDEO_DUR_MIN=1
# ARK_VIDEO_DUR_MAX=15
# ARK_VIDEO_RATIO=9:16
# ARK_VIDEO_RESOLUTION=720p

# ====== 可选：通用 HTTP 通道（CHANNEL=generic_http 时使用）======
# 视频
# VIDEO_HTTP_SUBMIT_URL=https://api.example.com/v1/video/generate
# VIDEO_HTTP_POLL_URL=https://api.example.com/v1/video/result
# VIDEO_HTTP_TOKEN=your_bearer_token
# VIDEO_HTTP_TASK_ID_PATH=data.task_id
# VIDEO_HTTP_STATUS_PATH=data.status
# VIDEO_HTTP_POLL_METHOD=get
# VIDEO_HTTP_POLL_BODY={"requestId": "{task_id}"}
# VIDEO_HTTP_IMAGE_FIELD=image
# VIDEO_HTTP_IMAGE_MODE=base64
# VIDEO_HTTP_OMIT_FIELDS=duration
# VIDEO_HTTP_SUCCESS_STATUS=success
# VIDEO_HTTP_VIDEO_URL_PATH=data.video_url
# VIDEO_HTTP_EXTRA_FIELDS={}
# 图片
# IMAGE_HTTP_URL=https://api.example.com/v1/image/generate
# IMAGE_HTTP_TOKEN=your_bearer_token
# IMAGE_HTTP_URL_PATH=data.image_url

# ====== 可选：LLM 重试 ======
# LLM_MAX_RETRIES=3
# LLM_RETRY_BASE=2


# ============================================================
# 可观测性（可选）
# ============================================================
# 日志格式：text=彩色文本（本地默认）；json=单行结构化 JSON（生产，便于 Loki/ELK 采集）
LOG_FORMAT=text
# Sentry 错误监控 DSN，留空则不启用（需 pip install sentry-sdk，镜像已内置）
SENTRY_DSN=
# Sentry 性能采样率 0~1（生产建议 0.05）
SENTRY_TRACES_SAMPLE=0.05
APP_VERSION=0.1.0

# ============================================================
# 异步任务队列（可选）：视频生成/合成改 Celery + Redis，避免长任务阻塞 Web
# ============================================================
# false=本地进程内 asyncio 后台任务（默认，零额外依赖）；
# true =投递到 Celery 队列，由独立 celery-worker 进程消费（需同时启动 redis 与 worker）
USE_CELERY=false
# Redis 地址（docker compose 内部为 redis://redis:6379/0；本地裸跑填 redis://127.0.0.1:6379/0）
REDIS_URL=
# 以下留空即回退 REDIS_URL
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
# 单个 worker 并发视频任务数（对齐 VIDEO_MAX_CONCURRENCY）
CELERY_CONCURRENCY=2
