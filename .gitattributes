# 默认：让 Git 自动识别文本/二进制
* text=auto

# Shell 脚本必须 LF（Linux 服务器执行，CRLF 会报 /bin/bash^M 错误）
*.sh   text eol=lf
# Dockerfile / compose / Python 一律 LF
Dockerfile       text eol=lf
docker-compose.yml text eol=lf
*.py   text eol=lf
*.js   text eol=lf
*.vue  text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Windows PowerShell 脚本用 CRLF（PS 5.1 兼容性更好）
*.ps1  text eol=crlf

# 二进制不做行尾转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.mp4  binary
*.mp3  binary
*.wav  binary
*.tar.gz binary
*.sql.gz binary
*.woff2 binary
