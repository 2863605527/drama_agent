# ============================================================
# Drama-Agent .env 配置示例
# ============================================================
# 复制本文件为 .env： cp .env.example .env，然后填入你的真实凭据
# 完整文档：https://github.com/your-org/drama-agent  或 SKILL.md 第 N 章
# ------------------------------------------------------------

# ====== 火山即梦 CV 通道（默认图片/视频通道）======
VOLC_ACCESS_KEY=你的火山引擎AccessKey
VOLC_SECRET_KEY=你的火山引擎SecretKey
VOLC_REGION=cn-beijing

# ====== 媒体通道配置（换供应商/换通道只改这里，不改代码）======
# 通道类型：
#   volc_cv       火山即梦视觉服务（默认，无 seedance 原生音频但够用）
#   volc_ark      火山方舟 Seedance 2.0(视频) + Seedream(图片)，原生参考图 + 原生音频
#   generic_http  通用 HTTP 第三方（OpenAI 兼容协议）
#
# 切换规则：
#   · 同通道换模型：只改 IMAGE_REQ_KEY / VIDEO_REQ_KEY 或 ARK_*_MODEL
#   · 跨供应商换通道：改 IMAGE_CHANNEL / VIDEO_CHANNEL + 对应通道的凭据/地址
IMAGE_CHANNEL=volc_cv
VIDEO_CHANNEL=volc_cv

# --- 方舟通道（volc_ark）---
# 需在火山方舟控制台开通 Seedance + Seedream 并新建 Key（volc-sk-xxx）
# 与即梦 AK/SK 不通用
ARK_API_KEY=
ARK_API_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_IMAGE_MODEL=doubao-seedream-5-0-260128
ARK_VIDEO_MODEL=doubao-seedance-2-0-260128
ARK_VIDEO_RESOLUTION=720p
ARK_VIDEO_RATIO=9:16
ARK_VIDEO_AUDIO=true
ARK_VIDEO_DUR_MIN=4
ARK_VIDEO_DUR_MAX=15

# --- 通用 HTTP 通道（generic_http）---
# 任何 OpenAI/Anthropic 风格协议的第三方供应商都可接入
# 图片：POST {IMAGE_HTTP_URL} 请求体 {prompt,width,height}，结果按 IMAGE_HTTP_URL_PATH 提取
# 视频：POST {VIDEO_HTTP_SUBMIT_URL} 提交，GET {VIDEO_HTTP_POLL_URL} 轮询
IMAGE_HTTP_URL=
IMAGE_HTTP_TOKEN=
IMAGE_HTTP_URL_PATH=data[0].url
VIDEO_HTTP_SUBMIT_URL=
VIDEO_HTTP_POLL_URL=
VIDEO_HTTP_TOKEN=
VIDEO_HTTP_TASK_ID_PATH=data.task_id
VIDEO_HTTP_STATUS_PATH=data.status
VIDEO_HTTP_SUCCESS_STATUS=succeeded
VIDEO_HTTP_VIDEO_URL_PATH=data.content.video_url
VIDEO_HTTP_EXTRA_FIELDS=

# ====== 大模型 LLM（OpenAI 兼容协议，可换任何厂商）======
# 推荐供应商 + URL：
#   DeepSeek   https://api.deepseek.com            模型: deepseek-chat / deepseek-reasoner
#   Moonshot   https://api.moonshot.cn             模型: moonshot-v1-8k / moonshot-v1-32k / kimi-k2
#   阿里百炼   https://dashscope.aliyuncs.com/compatible-mode/v1  模型: qwen-plus / qwen-max / qwen-long
#   智谱       https://open.bigmodel.cn/api/paas/v4/chat/completions  模型: glm-4-plus / glm-4-flash
#   OpenAI     https://api.openai.com/v1           模型: gpt-4o / gpt-4o-mini
#   Claude     https://api.anthropic.com/v1         模型: claude-3-5-sonnet（需要 Anthropic SDK 兼容代理）
#   本地 vLLM  http://localhost:8000/v1            模型: 任意本地 HuggingFace 模型
#
# 注意：DeepSeek / Moonshot / Qwen / GLM / OpenAI 都是 OpenAI Chat Completions 兼容协议
#       直接改 LLM_API_URL + LLM_API_KEY + LLM_MODEL 即可切换，无需改代码
LLM_API_URL=https://api.deepseek.com
LLM_API_KEY=你的LLM-API-Key
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.7
# LLM 空响应/5xx 自动重试次数（默认 3，指数退避 2/4/8 秒）
LLM_MAX_RETRIES=3

# ====== 火山即梦文生图 req_key ======
# 通用通用（默认）：jimeng_high_aes_general_v21_L
# 高质量写实推荐：jimeng_high_aes_general_v30 / 走方舟 Seedream 更稳
# 注意：jimeng_* 通用模型对"真人写实"风格响应弱，建议选 realistic 时改用方舟 Seedream
IMAGE_REQ_KEY=jimeng_high_aes_general_v21_L
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024

# ====== 火山即梦文生视频 req_key ======
# 即梦通用：jimeng_t2v_v30 / jimeng_t2v_v20（支持图生视频，接收 image_url 参数）
# Seedance：切到 volc_ark 通道，使用 ARK_VIDEO_MODEL
VIDEO_REQ_KEY=jimeng_t2v_v30
VIDEO_DURATION=4
VIDEO_RESOLUTION=720p
VIDEO_MAX_CONCURRENCY=2
IMAGE_MAX_CONCURRENCY=3

# ====== 视频时长策略 ======
# 档位制（即梦 frames 制）：VIDEO_DURATION_SLOTS=5,10 + VIDEO_SLOT_FRAMES=121,241 + VIDEO_SLOT_PARAM=frames
# 任意时长制（Seedance）：VIDEO_DURATION_SLOTS=any + VIDEO_TRIM=false
# LLM 分配范围：默认 2,10（档位制模型上限）；切 Seedance 后改为 1,15
VIDEO_DURATION_SLOTS=5,10
VIDEO_SLOT_FRAMES=121,241
VIDEO_SLOT_PARAM=frames
VIDEO_ANY_PARAM=duration
VIDEO_DURATION_RANGE=2,10
VIDEO_TRIM=true

# ====== TTS 配音（仅 cv 通道需要，方舟 Seedance 原生音频时忽略）======
# 是否启用配音：1 开启 / 0 关闭
ENABLE_TTS=1
# 音色：zh-CN-XiaoxiaoNeural 女声温柔 / zh-CN-YunxiNeural 男声阳光 / zh-CN-YunyangNeural 男声播音
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_RATE=+8%

# ====== 片段时长上限（硬性）======
# 单个片段视频的总时长硬性上限（秒），超过会自动切段；默认 15s
SEGMENT_MAX_DURATION=15
